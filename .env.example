# ==============================================================================
# CanchaYa - Plantilla de variables de entorno (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo a `.env` en la raíz del repositorio:
#      cp .env.example .env
# 2. En desarrollo local usa SIEMPRE las credenciales del proyecto `staging`
#    (canchaya-staging), nunca las de `production`.
# 3. NUNCA subas archivos `.env` reales a Git ni imprimas secretos en logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO DE APLICACIÓN
# ------------------------------------------------------------------------------
# Ambiente activo: "development" | "staging" | "production"
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. SUPABASE (Base de datos PostgreSQL, Auth y Row Level Security)
# ------------------------------------------------------------------------------
# Reference ID del proyecto (Supabase Dashboard > Project Settings > General).
# Usado por Supabase CLI y por GitHub Actions para aplicar migraciones.
SUPABASE_PROJECT_ID=

# URL base del proyecto (Project Settings > Data API > Project URL).
# Ejemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co (sin /rest/v1/ al final).
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública del proyecto (Project Settings > API Keys).
# Acepta la clave `anon` (legacy JWT) o la `Publishable key` (sb_publishable_...).
# Es segura en el navegador únicamente porque todas las tablas tienen RLS activo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta administrativa (Project Settings > API Keys).
# Acepta la clave `service_role` (legacy JWT) o la `Secret key` (sb_secret_...).
# ADVERTENCIA: Salta Row Level Security. Uso EXCLUSIVO en servidor (API routes /
# jobs). NUNCA exponer al cliente ni renombrar con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. META WHATSAPP CLOUD API (Webhook y mensajería del bot - Épica E3)
# ------------------------------------------------------------------------------
# ID del número de teléfono en Meta for Developers (WhatsApp > API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# Token de acceso permanente del usuario de sistema en Meta Business Suite.
# Uso EXCLUSIVO en servidor.
WHATSAPP_ACCESS_TOKEN=

# Clave secreta de la app en Meta (App Settings > Basic > App Secret).
# Se usa para validar la firma HMAC-SHA256 (X-Hub-Signature-256) en el webhook.
WHATSAPP_APP_SECRET=

# Cadena secreta definida por nosotros para verificar el reto GET del webhook
# de Meta (`hub.verify_token`).
WHATSAPP_VERIFY_TOKEN=
